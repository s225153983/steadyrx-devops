# Production environment. Shorter token life and quieter logs.
# Demo accounts stay seeded because this is a student demonstration system.
DEPLOY_ENV=production
HOST_PORT=8000
APP_ENV=production
LOG_LEVEL=INFO
SEED_DEMO_DATA=true
JWT_TTL_MINUTES=15
RISK_THRESHOLD_HIGH=0.6
RISK_THRESHOLD_MEDIUM=0.3
ALLOWED_ORIGINS=https://pharmacist.steadyrx.example
